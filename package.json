{
  "name": "pi-subagents",
  "version": "0.1.0",
  "private": true,
  "description": "Pi sub-agents: spawn/stop/send a tree of named, message-passing pi agents. Derived from @everyx/pi-subagent, with pi-ui inlined.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "subagent"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chthub/pi-subagents.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "fix": "biome check --write .",
    "test": "tsx --test test/*.test.ts test/ui/*.test.ts",
    "preview": "tsx preview.ts",
    "test:e2e": "node test/e2e/rpc-host.mjs"
  },
  "files": [
    "*.ts",
    "ui/*.ts",
    "README.md",
    "README.zh.md",
    "SPEC.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.23.1",
    "typebox": "1.3.27",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
